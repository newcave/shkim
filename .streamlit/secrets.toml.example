# 이 파일을 secrets.toml로 복사해 값을 채우세요. secrets.toml은 절대 커밋하지 않습니다.
# Community Cloud에서는 앱 설정 > Secrets에 같은 내용을 붙여넣습니다.

# Supabase 연결 전에 샘플 데이터로 화면을 확인하려면 true. 운영 시 false 또는 삭제.
DEMO_MODE = true

# 열람 게이트: "code"(접근코드) 또는 "invite"(Community Cloud 비공개 앱 초대)
APP_GATE_MODE = "code"
APP_ACCESS_CODE = "change-me"

# 관리 페이지를 볼 수 있는 Google 계정 (아래 [auth] 설정 필요)
ADMIN_EMAILS = ["you@example.com"]

SUPABASE_URL = "https://xxxxxxxx.supabase.co"
SUPABASE_SERVICE_KEY = "service_role 키"

# 게시판 Google 인증 (st.login). 아직 준비되지 않았다면 [auth] 블록 전체를 지우세요.
[auth]
redirect_uri = "http://localhost:8501/oauth2callback"   # 배포 후: https://<앱>.streamlit.app/oauth2callback
cookie_secret = "길고 무작위한 문자열로 교체"
client_id = "Google OAuth 클라이언트 ID"
client_secret = "Google OAuth 클라이언트 시크릿"
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"
